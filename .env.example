# Chay "npm run setup" trong backend de tu tao .env va mat khau ngau nhien.
# MongoDB local (can cai MongoDB Community Server va bat dich vu):
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=expression_lab
# Atlas: thay MONGO_URI bang URI mongodb+srv cua ban.
ADMIN_EMAIL=admin@expressionlab.com
ADMIN_PASSWORD=replace_with_at_least_10_characters
APP_PORT=8010
# Frontend mac dinh proxy den APP_PORT. Chi can neu dung backend tren may khac:
# VITE_API_TARGET=http://127.0.0.1:8010
# Tuy chon neu chay Docker Compose:
MONGO_PASSWORD=replace_with_random_password
