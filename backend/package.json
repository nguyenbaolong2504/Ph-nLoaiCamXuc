{
  "name": "expression-lab-backend",
  "version": "1.0.0",
  "private": true,
  "description": "npm commands for the local Python AI backend",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node ../scripts/local.mjs setup",
    "setup:ai": "node ../scripts/local.mjs setup-ai",
    "dev": "node ../scripts/local.mjs dev",
    "start": "node ../scripts/local.mjs start",
    "data:prepare": "node ../scripts/local.mjs prepare",
    "data:audit": "node ../scripts/local.mjs audit",
    "train": "node ../scripts/local.mjs train",
    "evaluate": "node ../scripts/local.mjs evaluate",
    "compare": "node ../scripts/local.mjs compare"
  }
}
